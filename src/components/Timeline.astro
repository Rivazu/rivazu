---
import { timeline } from "../data/timeline";

const sorted = [...timeline].sort((a, b) => {
    const aEnd = a.end_date ?? Infinity;
    const bEnd = b.end_date ?? Infinity;
    
    if (bEnd !== aEnd) return bEnd - aEnd;
    return b.start_date - a.start_date;
});

function formatRange(start_date: number, end_date: number | null ) {
    return end_date ? `${start_date} - ${end_date}` : `${start_date} - `;
}
---

<section class="timeline">
    <ul>
        {
            sorted.map((entry) => (
                <li>
                    <span class="timeline-date">{formatRange(entry.start_date, entry.end_date)}</span>
                    <div class="timeline-content">
                        <strong>{entry.job_title}</strong>
                        {entry.org && <span> @ {entry.org}</span>}
                        <p>{entry.body}</p>
                    </div>
                </li>
            ))
        }
    </ul>
</section>