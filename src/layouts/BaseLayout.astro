---
import "../styles/global.css";

interface Props {
    title?: string;
}

const { title = "Rivazu" } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === "/";
const isProjects = path === "/projects" || path.startsWith("/projects/");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>
    <body>
        <div class="shell">
            <aside class="sidebar">
                <a class="sidebar-brand" href="/">Rivazu</a>
                <nav class="sidebar-nav" aria-label="Primary">
                    <a href="/" class:list={[{ active: isHome }]}>Home</a>
                    <a href="/projects" class:list={[{ active: isProjects }]}>Projects</a>
                </nav>
            </aside>
            <div class="content">
                <slot />
            </div>
        </div>
    </body>
</html>
